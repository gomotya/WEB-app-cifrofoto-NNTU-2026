<!doctype html><html lang="ru"><head><meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · Цифровое фото</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><header><a href="/">◉ Цифровое фото</a><nav>
@if (User.Identity?.IsAuthenticated == true) {
<a href="/Staff">Рабочая страница</a>
<form method="post" action="/Account/Logout">@Html.AntiForgeryToken()<button>Выйти</button></form>
} else { <a href="/Account/Login">Сотрудникам</a> }
</nav></header><main>@RenderBody()</main>
<footer>Дзержинск, пр. Циолковского, 21Г · Пн–пт 10:00–18:00 · +7 (908) 725-72-14</footer>
</body></html>
